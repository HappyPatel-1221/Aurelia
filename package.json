{
  "name": "jewellery-website-demo",
  "version": "1.0.0",
  "description": "Luxury Jewellery Website Demo - Storefront, Customer, Owner, Delivery panels",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "client-install": "npm install --prefix frontend",
    "client-build": "npm run build --prefix frontend",
    "client-dev": "npm run dev --prefix frontend",
    "install-all": "npm install && npm run client-install",
    "dev": "concurrently \"npm run start\" \"npm run client-dev\"",
    "build": "npm run client-install && npm run client-build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
